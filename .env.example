# ============================================
# GPRO Immobilier - Configuration
# ============================================

# --- Base de données PostgreSQL ---
# Obtenez une URL gratuite sur https://neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/gpro_immobilier?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/gpro_immobilier?sslmode=require&pgbouncer=true"

# URL directe (sans pgbouncer) - nécessaire pour Prisma Migrate
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/gpro_immobilier?sslmode=require"

# --- Admin ---
# Code secret pour créer un compte administrateur
ADMIN_SECRET_CODE=gpro2025
