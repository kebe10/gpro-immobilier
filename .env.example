# --- Base de données PostgreSQL ---
# Obtenez une URL gratuite sur https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentification JWT ---
# Changez cette valeur pour un secret unique en production
JWT_SECRET="gpro-immobilier-jwt-secret-2026"

# --- Admin ---
# Code secret pour créer un compte administrateur
ADMIN_SECRET_CODE=gpro2025
